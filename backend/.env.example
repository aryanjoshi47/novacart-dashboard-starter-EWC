# ── Data backend ─────────────────────────────────────────────────────────────
# 'sqlite'    = use local SQLite file (default for local development)
# 'snowflake' = use Snowflake (used in SPCS deployment)
DATA_BACKEND=sqlite

# ── SQLite (local development only) ──────────────────────────────────────────
SQLITE_PATH=../data/novacart_gold.db

# ── Snowflake (fill in when using Snowflake) ──────────────────────────────────
# Find your account identifier: SELECT CURRENT_ACCOUNT(), CURRENT_REGION();
# Format: <locator>.<region>  e.g. ABC12345.us-east-1
SNOWFLAKE_ACCOUNT=your_account.your_region

# Find your exact username: SELECT CURRENT_USER();
SNOWFLAKE_USERNAME=YOUR_USERNAME

SNOWFLAKE_ROLE=NOVACART_APP_ROLE
SNOWFLAKE_WAREHOUSE=NOVACART_APP_WH
SNOWFLAKE_DATABASE=NOVACART_DB
SNOWFLAKE_SCHEMA=APP

# Keypair authentication (required if your account enforces MFA)
# Generate: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

# ── Access control ────────────────────────────────────────────────────────────
# Comma-separated list of Snowflake usernames that have admin access (case-insensitive).
# Admin users can see all pages including /customers.
# Everyone else is treated as a viewer (Orders + Products only).
# Example: ADMIN_USERS=PGUERRERO,DEVINLIU
ADMIN_USERS=

# Demo role override — only used when CLIENT_VALIDATION=Dev (local development).
# Set to 'admin' to simulate an admin user, 'viewer' to simulate a viewer.
# Has no effect in production (SPCS).
DEMO_ROLE=viewer

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
